<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissões -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vortex"
        android:name=".FinanceAIApp">

        <!-- SplashActivity (ponto de entrada) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Vortex.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- LoginActivity -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <!-- MainActivity (dashboard principal) -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- AddTransactionActivity -->
        <activity
            android:name=".activities.AddTransactionActivity"
            android:exported="false"
            android:theme="@style/Theme.Vortex.Dark" />

        <!-- HistoryActivity -->
        <activity
            android:name=".activities.HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.Vortex.Dark" />

        <!-- CameraActivity (foto OCR) -->
        <activity
            android:name=".activities.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- TransactionDetailActivity -->
        <activity
            android:name=".activities.TransactionDetailActivity"
            android:exported="false" />

        <!-- GoalsActivity -->
        <activity
            android:name=".activities.GoalsActivity"
            android:exported="false" />

        <!-- InvestimentosActivity -->
        <activity
            android:name=".activities.InvestimentosActivity"
            android:exported="false"
            android:theme="@style/Theme.Vortex.Dark" />

        <!-- ReportsActivity -->
        <activity
            android:name=".activities.ReportsActivity"
            android:exported="false" />

        <!-- SettingsActivity -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false" />

        <!-- NotificationReceiver -->
        <receiver
            android:name=".utils.NotificationReceiver"
            android:exported="false" />

        <!-- FileProvider para câmera -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>