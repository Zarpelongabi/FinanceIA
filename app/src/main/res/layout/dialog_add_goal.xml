<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_neon_card"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="Guardar para:"
        android:textColor="@color/white"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Planeje seu futuro com precisão"
        android:textColor="@color/text_gray"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <!-- Nome da Meta (Lápis) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_goal_title"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do sonho"
            app:boxBackgroundColor="#151C27"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeColor="@color/primary_eco"
            app:startIconDrawable="@android:drawable/ic_menu_edit"
            app:startIconTint="@color/primary_eco"
            app:hintTextColor="@color/primary_eco">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_goal_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:paddingVertical="20dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Valor Alvo (Aviãozinho/Seta) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_goal_target"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Quanto deseja guardar? (R$)"
            app:boxBackgroundColor="#151C27"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeColor="@color/primary_eco"
            app:startIconDrawable="@android:drawable/ic_menu_send"
            app:startIconTint="@color/primary_eco"
            app:hintTextColor="@color/primary_eco">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_goal_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textColor="@color/white"
                android:paddingVertical="20dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Prazo em Meses (Calendário) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_goal_deadline"
            style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Em quantos meses?"
            app:boxBackgroundColor="#151C27"
            app:boxCornerRadiusTopStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="2dp"
            app:boxStrokeColor="@color/primary_eco"
            app:startIconDrawable="@android:drawable/ic_menu_today"
            app:startIconTint="@color/primary_eco"
            app:hintTextColor="@color/primary_eco">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_goal_deadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/white"
                android:paddingVertical="20dp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Recomendação Vortex AI -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_recommendation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#1A00D2FF"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_rec_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vortex_ai_recommendation"
                    android:textColor="@color/primary_eco"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_monthly_saving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="R$ 0,00 / mês"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-condensed-medium" />

                <TextView
                    android:id="@+id/tv_recommendation_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Este é o valor mensal necessário."
                    android:textColor="@color/text_gray"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_goal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="Confirmar"
            android:textColor="@color/bg_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_eco"
            app:cornerRadius="20dp" />

        <Button
            android:id="@+id/btn_cancel_goal"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="AGORA NÃO"
            android:textColor="@color/text_gray"
            android:letterSpacing="0.1" />

    </LinearLayout>
</LinearLayout>